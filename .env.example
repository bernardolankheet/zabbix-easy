# Porta exposta no host
APP_PORT=8080

# Zabbix Server — hostid usado para coletar processos/pollers do server
ZABBIX_SERVER_HOSTID=10084

# Performance
MAX_CONCURRENT=10
API_TIMEOUT_SECONDS=60
CHECKTRENDTIME=15d

# Logs (produção: false)
APP_DEBUG=false

# Segurança (recomendado em produção)
# APP_API_KEY=troque-por-uma-chave-forte
# ZABBIX_TLS_VERIFY=true

# PostgreSQL — descomente no docker-compose.prod.yml e use: --profile db
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=troque-a-senha
# DB_NAME=zabbix_report
